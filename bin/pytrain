#!/usr/bin/env python3
"""
pytrain — a console trainer for the whole Python language and ecosystem.

Each task gives you a real, well-specified piece of code to write; the grader
then runs a pytest suite against *your* file in an isolated venv, asserting
behaviour (never style) the way a code review or CI pipeline would.

Usage:
    pytrain learn                 # teach the next new task, then let you try it
    pytrain train                 # auto-pick what to do next (review or new) and start it
    pytrain check                 # grade the task you're currently on
    pytrain list [domain]         # all tasks, grouped by domain, with your status
    pytrain start  <id>           # create your workspace for a task and show the spec
    pytrain check  <id>           # grade your solution (pass/fail per test)
    pytrain solution <id>         # reveal the reference solution
    pytrain reset  <id>           # restore the starter scaffold (your file is backed up)
    pytrain status                # your XP, streak, and per-domain completion

New to the material?  Run `pytrain learn` — it explains the concept behind the
next task, then sets up its workspace so you can try it. Once you know the
ropes, `pytrain train` just picks what to practise next (new material in a
fundamentals-first order, or a spaced-repetition review) so you don't decide.

<id> can be the full "domain/nn-name" or just the unique trailing name. For
check/solution/reset you can omit <id> to act on the task train/start gave you.

Your working files live in workspace/<domain>/<nn-name>/ inside this clone
(gitignored). Progress is stored in ~/.local/state/pytrain/progress.json.

Tasks that need third-party packages (fastapi, pandas, ...) declare them in
meta.json; check provisions a cached venv per dependency set (uv if available,
else venv+pip) so the first check installs once and later checks are instant.
Runs on any Python >= 3.11 — the runner itself is stdlib only.
"""
import json
import hashlib
import os
import re
import shutil
import subprocess
import sys
from datetime import date, timedelta
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TASKS = REPO / "tasks"
WORKSPACE = REPO / "workspace"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "pytrain"
STATE = STATE_DIR / "progress.json"
VENVS = STATE_DIR / "venvs"
MIN_PY = (3, 11)

# How the learner invoked us, so hints name a command they can actually run.
# SELF is the runnable path (e.g. ./bin/pytrain) — used for hints that take an
# <id>. INVOKE is what to suggest for the plain verbs: `make <verb>` when run
# under make (MAKELEVEL is set), otherwise the same path.
SELF = sys.argv[0] or "./bin/pytrain"
INVOKE = "make" if os.environ.get("MAKELEVEL") else SELF

# ---- colours ---------------------------------------------------------------
_tty = sys.stdout.isatty()
def c(code, s):
    return f"\033[{code}m{s}\033[0m" if _tty else s
GRN = lambda s: c("32", s)
RED = lambda s: c("31", s)
YEL = lambda s: c("33", s)
BLU = lambda s: c("34", s)
MAG = lambda s: c("35", s)
DIM = lambda s: c("2", s)
BLD = lambda s: c("1", s)

XP_BY_DIFFICULTY = {1: 10, 2: 15, 3: 25, 4: 40, 5: 60}

# ---- state -----------------------------------------------------------------
def load_state():
    try:
        st = json.loads(STATE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        st = {"tasks": {}, "xp": 0, "streak": {"count": 0, "last": ""}}
    # Fields added by train/learn; backfill so older progress files still load.
    st.setdefault("current", None)
    st.setdefault("recent_picks", [])
    return st

def save_state(st):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(json.dumps(st, indent=2))

def bump_streak(st):
    today = date.today()
    s = st["streak"]
    if s["last"] == today.isoformat():
        return
    if s.get("last") and date.fromisoformat(s["last"]) == today - timedelta(days=1):
        s["count"] += 1
    else:
        s["count"] = 1
    s["last"] = today.isoformat()

# ---- spaced repetition -----------------------------------------------------
# Days until the next review, indexed by how many times you've passed the task.
# After the table runs out we keep roughly doubling. Same ladder as the redhat
# trainer: quick early reinforcement, then widening gaps.
REVIEW_INTERVALS = [1, 3, 7, 16, 35, 75]

def review_interval(reps):
    """Days until the next review after `reps` successful passes (reps >= 1)."""
    i = max(reps, 1) - 1
    if i < len(REVIEW_INTERVALS):
        return REVIEW_INTERVALS[i]
    return REVIEW_INTERVALS[-1] * (2 ** (i - len(REVIEW_INTERVALS) + 1))

def days_overdue(iso_due):
    """How many days past its review date a task is (>=0 means due now).
    None if it has no scheduled review yet."""
    if not iso_due:
        return None
    return date.today().toordinal() - date.fromisoformat(iso_due).toordinal()

def schedule_review(entry, reps):
    """Record the next review date `review_interval(reps)` days out."""
    entry["reps"] = reps
    due = date.fromordinal(date.today().toordinal() + review_interval(reps))
    entry["due"] = due.isoformat()

# ---- task discovery --------------------------------------------------------
def discover():
    """Return {task_id: meta_dict} for every task, in sorted order."""
    tasks = {}
    if not TASKS.is_dir():
        return tasks
    for meta_path in sorted(TASKS.glob("*/*/meta.json")):
        d = meta_path.parent
        tid = f"{d.parent.name}/{d.name}"
        try:
            meta = json.loads(meta_path.read_text())
        except json.JSONDecodeError as e:
            print(YEL(f"warning: bad meta.json in {tid}: {e}"), file=sys.stderr)
            continue
        meta["_dir"] = d
        tasks[tid] = meta
    return tasks

def resolve(tasks, ident):
    """Accept 'domain/nn-name' or a unique trailing 'nn-name' / 'name'."""
    if ident in tasks:
        return ident
    hits = [t for t in tasks if t.split("/", 1)[1] == ident]
    if not hits:
        hits = [t for t in tasks if re.sub(r"^\d+-", "", t.split("/", 1)[1]) == ident]
    if len(hits) == 1:
        return hits[0]
    if len(hits) > 1:
        die(f"'{ident}' is ambiguous: {', '.join(hits)}")
    die(f"no task called '{ident}' (try: pytrain list)")

def die(msg):
    print(RED(f"error: {msg}"), file=sys.stderr)
    sys.exit(1)

def task_python_ok(meta):
    """Check this interpreter meets the task's optional 'python' minimum."""
    want = meta.get("python")
    if not want:
        return True
    try:
        parts = tuple(int(x) for x in str(want).split("."))
    except ValueError:
        return True
    return sys.version_info >= parts

# ---- what to teach next ----------------------------------------------------
# Teaching order for NEW material: fundamentals first, then things that build on
# them, heaviest/ecosystem domains last. Keyed by the task's domain directory;
# anything unlisted sorts after these. Within a domain the nn- prefix already
# runs easy->hard, so (domain rank, id) is the full teaching order.
#
# Rationale (each tier only leans on earlier ones):
#   core     the language itself — everything below uses it
#   stdlib   the everyday batteries (collections, itertools, dataclasses, re...)
#   dsa      algorithmic problem-solving with plain core + stdlib
#   oop      classes & design patterns
#   typing   annotate the code you can now write
#   testing  prove that code with pytest
#   concurrency  threads/async — advanced runtime behaviour
#   packaging    ship what you've built
#   web / data   third-party ecosystems (frameworks, numeric/ML stacks)
#   projects     multi-file capstones that combine everything
DOMAIN_ORDER = {
    "core": 0, "stdlib": 1, "dsa": 2, "oop": 3, "typing": 4, "testing": 5,
    "concurrency": 6, "packaging": 7, "web": 8, "data": 9, "projects": 10,
}

def curriculum_key(tid):
    """Sort key placing a task in teaching order: (domain rank, then its id)."""
    return (DOMAIN_ORDER.get(tid.split("/")[0], 99), tid)

def is_done(st, tid):
    return bool(st["tasks"].get(tid, {}).get("passed"))

def selectable(meta):
    """Can this task actually be attempted on this interpreter? (Missing
    third-party deps aren't known until a venv build, so we don't gate on
    them here — check reports those as SKIP.)"""
    return task_python_ok(meta)

def due_reviews(tasks, st):
    """Passed tasks whose review date has arrived, most overdue first. A passed
    task with no schedule yet (e.g. from before spaced repetition existed) counts
    as due, so it re-enters the rotation."""
    out = []
    for tid, entry in st["tasks"].items():
        if not entry.get("passed"):
            continue
        meta = tasks.get(tid)
        if not meta or not selectable(meta):
            continue
        overdue = days_overdue(entry.get("due"))
        if overdue is None or overdue >= 0:
            out.append((overdue if overdue is not None else 0, tid, meta))
    out.sort(key=lambda x: -x[0])           # most overdue first
    return [(tid, meta) for _, tid, meta in out]

def next_new(tasks, st):
    """First not-yet-passed task in teaching order (fundamentals first). An
    in-progress task counts as not-done, so this resumes unfinished work."""
    for tid in sorted(tasks, key=curriculum_key):
        if is_done(st, tid):
            continue
        if not selectable(tasks[tid]):
            continue
        return tid, tasks[tid]
    return None

def soonest_review(tasks, st):
    """The nearest upcoming (not-yet-due) review, as (days_away, tid, meta)."""
    best = None
    for tid, entry in st["tasks"].items():
        if not entry.get("passed"):
            continue
        meta = tasks.get(tid)
        due = entry.get("due")
        if not meta or not due:
            continue
        away = -days_overdue(due)
        if away > 0 and (best is None or away < best[0]):
            best = (away, tid, meta)
    return best

def choose_task(tasks, st):
    """Decide what to practise next. Pure — no side effects, so it's testable.
    Returns (tid, meta, kind, reason). kind is 'review', 'new', or None.

    Reviews take priority once due, but never more than two in a row while new
    material is still waiting, so new content always keeps advancing."""
    reviews = due_reviews(tasks, st)
    new = next_new(tasks, st)
    recent = st.get("recent_picks", [])
    review_wall = len(recent) >= 2 and recent[-1] == "review" and recent[-2] == "review"

    if reviews and not (review_wall and new):
        (tid, meta), kind = reviews[0], "review"
    elif new:
        (tid, meta), kind = new, "new"
    elif reviews:                       # only reviews left (all new material done)
        (tid, meta), kind = reviews[0], "review"
    else:
        return None, None, None, ""

    if kind == "review":
        overdue = days_overdue(st["tasks"][tid].get("due"))
        reason = "due for review" if not overdue else f"review — {overdue}d overdue"
    elif st["tasks"].get(tid, {}).get("attempts"):
        reason = "resume — started but not yet passed"
    else:
        reason = "new material, next in sequence"
    return tid, meta, kind, reason

# ---- workspace -------------------------------------------------------------
def ws_dir(tid):
    return WORKSPACE / tid

def populate_workspace(tid, meta, force=False):
    """Copy the starter scaffold into workspace/<tid>. Returns the dir."""
    src = meta["_dir"]
    dst = ws_dir(tid)
    existing = dst / "solution.py"
    if existing.exists() and not force:
        return dst
    if force and dst.exists():
        backup = dst.with_name(dst.name + ".bak")
        shutil.rmtree(backup, ignore_errors=True)
        shutil.copytree(dst, backup)
        shutil.rmtree(dst)
        print(DIM(f"previous work backed up to {backup.relative_to(REPO)}"))
    dst.mkdir(parents=True, exist_ok=True)
    starter_dir = src / "starter"
    if starter_dir.is_dir():
        shutil.copytree(starter_dir, dst, dirs_exist_ok=True)
    elif (src / "starter.py").exists():
        shutil.copy(src / "starter.py", dst / "solution.py")
    else:
        (dst / "solution.py").write_text(
            '"""Write your solution here — see the task prompt."""\n'
        )
    return dst

# ---- venv provisioning -----------------------------------------------------
def venv_for(deps):
    """Return (python_exe, note) for a cached venv containing pytest + deps.

    note is None on success, or a human-readable reason the venv is unavailable
    (offline, install failure) — the caller reports the task as SKIPPED.
    """
    deps = sorted(set(deps) | {"pytest"})
    key = hashlib.sha256((sys.executable + "\n" + "\n".join(deps)).encode()).hexdigest()[:16]
    vdir = VENVS / key
    exe = vdir / ("Scripts/python.exe" if os.name == "nt" else "bin/python")
    stamp = vdir / "ok.stamp"
    if stamp.exists() and exe.exists():
        return str(exe), None
    VENVS.mkdir(parents=True, exist_ok=True)
    # Several pytrain/selftest processes may want the same dep-set at once;
    # first one in builds, the rest wait on the stamp.
    lock = vdir.with_suffix(".lock")
    try:
        fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        os.close(fd)
    except FileExistsError:
        import time
        for _ in range(600):
            if stamp.exists() and exe.exists():
                return str(exe), None
            if not lock.exists():
                break
            time.sleep(1)
        return venv_for(deps)
    try:
        shutil.rmtree(vdir, ignore_errors=True)
        uv = shutil.which("uv")
        print(DIM(f"provisioning venv for [{', '.join(deps)}] (first run only)..."))
        try:
            if uv:
                run([uv, "venv", "--python", sys.executable, str(vdir)])
                run([uv, "pip", "install", "--python", str(exe), *deps])
            else:
                run([sys.executable, "-m", "venv", str(vdir)])
                run([str(exe), "-m", "pip", "install", "--quiet", *deps])
        except subprocess.CalledProcessError as e:
            shutil.rmtree(vdir, ignore_errors=True)
            tail = ((e.stderr or "") + (e.stdout or "")).strip().splitlines()[-3:]
            return None, "could not install " + ", ".join(deps) + \
                ("\n  " + "\n  ".join(tail) if tail else " — are you offline?")
        stamp.write_text("\n".join(deps))
        return str(exe), None
    finally:
        lock.unlink(missing_ok=True)

def run(cmd):
    return subprocess.run(cmd, check=True, capture_output=True, text=True,
                          stdin=subprocess.DEVNULL).stdout

# ---- grading ---------------------------------------------------------------
def grade(tid, meta):
    """Run the task's pytest grader against the learner's workspace.

    Returns (passed: bool, skipped_note: str|None, output: str).
    """
    ws = ws_dir(tid)
    if not (ws / "solution.py").exists() and not any(ws.glob("*.py")):
        return False, None, f"no workspace yet — run: pytrain start {tid}"
    exe, note = venv_for(meta.get("deps", []))
    if note:
        return False, note, ""
    env = os.environ.copy()
    env["PYTRAIN_WS"] = str(ws)
    env["PYTHONPATH"] = str(REPO / "grader")
    env.pop("PYTEST_ADDOPTS", None)
    grader = meta["_dir"] / "test_grade.py"
    proc = subprocess.run(
        [exe, "-m", "pytest", str(grader), "-q", "--no-header",
         "-p", "no:cacheprovider", "--rootdir", str(ws), "-x", "--tb=short"],
        capture_output=True, text=True, env=env, cwd=str(ws),
        stdin=subprocess.DEVNULL, timeout=meta.get("timeout", 120),
    )
    return proc.returncode == 0, None, proc.stdout + proc.stderr

# ---- commands ----------------------------------------------------------------
def cmd_list(args):
    tasks = discover()
    st = load_state()
    only = args[0] if args else None
    domains = {}
    for tid, meta in tasks.items():
        domains.setdefault(tid.split("/")[0], []).append((tid, meta))
    if only and only not in domains:
        die(f"no domain '{only}' (have: {', '.join(sorted(domains))})")
    for dom in sorted(domains):
        if only and dom != only:
            continue
        rows = domains[dom]
        done = sum(1 for tid, _ in rows if st["tasks"].get(tid, {}).get("passed"))
        print(f"\n{BLD(BLU(dom))} {DIM(f'({done}/{len(rows)})')}")
        for tid, meta in rows:
            rec = st["tasks"].get(tid, {})
            mark = GRN("✓") if rec.get("passed") else (YEL("…") if rec.get("attempts") else DIM("·"))
            stars = MAG("★" * meta.get("difficulty", 1))
            adv = YEL(" [advanced]") if "advanced" in meta.get("tags", []) else ""
            deps = DIM(f" ({', '.join(meta['deps'])})") if meta.get("deps") else ""
            print(f"  {mark} {tid.split('/', 1)[1]:<34} {stars:<18} "
                  f"{DIM(str(meta.get('est_min', '?')) + 'm')}  {meta['title']}{adv}{deps}")
    if not only:
        total = len(tasks)
        done = sum(1 for t in tasks if st["tasks"].get(t, {}).get("passed"))
        print(f"\n{BLD(f'{done}/{total} tasks complete')} — "
              f"{st['xp']} XP, {st['streak']['count']}-day streak")
        print(DIM("New to this?  ") + BLD(f"{INVOKE} learn")
              + DIM("  teaches the next one first."))
        print(DIM("Know it already?  ") + BLD(f"{INVOKE} train")
              + DIM("  just picks what to practise."))

def launch_task(st, tid, meta):
    """Show a task's spec, create its workspace, and mark it current. Shared by
    `start` and `train`. Returns the workspace dir."""
    if not task_python_ok(meta):
        print(YEL(f"note: this task wants Python >= {meta['python']}; "
                  f"you have {sys.version.split()[0]}. It may not be gradable here."))
    ws = populate_workspace(tid, meta)
    print(BLD(f"\n=== {meta['title']} ") + DIM(f"[{tid}]"))
    print(DIM(f"difficulty {'★' * meta.get('difficulty', 1)} · ~{meta.get('est_min', '?')} min"
              + (f" · needs: {', '.join(meta['deps'])}" if meta.get("deps") else "")))
    print()
    print((meta["_dir"] / "prompt.md").read_text())
    print(BLD("Your file(s): ") + str(ws.relative_to(REPO)) + "/")
    print(DIM("When ready:    ") + f"{INVOKE} check"
          + DIM(f"   (or: {SELF} check {tid})"))
    st["current"] = tid
    rec = st["tasks"].setdefault(tid, {"passed": False, "attempts": 0})
    save_state(st)
    return ws

def cmd_start(args):
    if not args:
        die(f"usage: {SELF} start <id>   (or just: {INVOKE} train)")
    tasks = discover()
    st = load_state()
    tid = resolve(tasks, args[0])
    launch_task(st, tid, tasks[tid])

def print_status_line(st):
    done = sum(1 for t in st["tasks"].values() if t.get("passed"))
    streak = st["streak"]["count"]
    unit = "day" if streak == 1 else "days"
    print(f"{BLD('XP')} {st['xp']}   {BLD('Streak')} {streak} {unit}   {BLD('Done')} {done}")

def cmd_train(args):
    tasks = discover()
    if not tasks:
        print(DIM("no tasks found")); return
    st = load_state()
    tid, meta, kind, reason = choose_task(tasks, st)
    if tid is None:
        print()
        print(GRN(BLD("All caught up — nothing due and no new tasks.")))
        nxt = soonest_review(tasks, st)
        if nxt:
            print(DIM(f"Next review ({tasks[nxt[1]]['title']}) comes due in {nxt[0]}d."))
        print()
        print_status_line(st)
        return
    st["recent_picks"] = (st.get("recent_picks", []) + [kind])[-4:]
    tag = YEL("REVIEW") if kind == "review" else GRN(" NEW  ")
    print()
    print_status_line(st)
    print(f"{tag}  {DIM(reason)}")
    if kind == "review":
        print(DIM("(your last solution is kept — re-solve from memory, or ")
              + f"{SELF} reset {tid}" + DIM(" for a clean slate)"))
    launch_task(st, tid, meta)

# ---- learn: an interactive tutor -------------------------------------------
def ask(msg):
    """Prompt the learner; treat a closed stdin (piped/non-interactive) as Enter."""
    try:
        return input(msg).strip().lower()
    except EOFError:
        print()
        return ""

def parse_lesson(text):
    """Split a lesson into a sequence of beats the tutor walks through:
        ('prose', text)    a chunk of the lecture, printed as-is
        ('pause', None)    a `---` line — wait for the learner before going on
        ('run',  [lines])  a ```run fenced block — run as ONE Python script
    A lesson with none of these markers is just one prose beat.

    Lines inside a ```run block are captured VERBATIM (indentation and blank
    lines preserved) so multi-line functions, classes and loops survive — the
    whole block is executed as a single script by run_lesson."""
    beats, buf, lines, i = [], [], text.splitlines(), 0
    def flush():
        if any(l.strip() for l in buf):
            beats.append(("prose", "\n".join(buf).strip("\n")))
        buf.clear()
    while i < len(lines):
        s = lines[i].strip()
        if s == "---":
            flush(); beats.append(("pause", None)); i += 1
        elif s.startswith("```run"):
            flush(); raw = []; i += 1
            while i < len(lines) and not lines[i].strip().startswith("```"):
                raw.append(lines[i]); i += 1      # verbatim — keep indentation
            i += 1                                 # skip the closing fence
            while raw and not raw[0].strip():  raw.pop(0)    # trim blank edges
            while raw and not raw[-1].strip(): raw.pop()
            if raw:
                beats.append(("run", raw))
        else:
            buf.append(lines[i]); i += 1
    flush()
    return beats

def run_lesson(beats):
    """Walk the learner through a parsed lesson. Prose is paced with pauses; a
    `run` block is shown, then executed live as a SINGLE Python script (with
    this same interpreter, in a throwaway temp dir) so the learner sees real
    output. Returns False if the learner quit early."""
    import tempfile
    for kind, payload in beats:
        if kind == "prose":
            print(payload)
        elif kind == "pause":
            if ask(DIM("\n  [Enter to continue · q to stop] ")) in ("q", "quit"):
                return False
            print()
        elif kind == "run":
            print()
            print(BLD("  Try this — Python:"))
            for line in payload:
                print(GRN("    " + line))
            ans = ask(DIM("  [Enter to run it here · s to skip · q to stop] "))
            if ans in ("q", "quit"):
                return False
            if ans in ("s", "skip"):
                continue
            print(DIM("  ── output " + "─" * 40))
            with tempfile.TemporaryDirectory() as td:
                script = Path(td) / "lesson_snippet.py"
                script.write_text("\n".join(payload) + "\n")
                subprocess.run([sys.executable, str(script)], cwd=td)
            print(DIM("  " + "─" * 49))
    return True

def cmd_learn(args):
    """Teach a task like a tutor: a paced lecture from learn.md that tells you
    which snippets to run as you go, then hands off to a solo attempt. With no
    id it teaches the next new task — the same one `train` would give you."""
    tasks = discover()
    st = load_state()
    if args:
        tid = resolve(tasks, args[0])
    else:
        nxt = next_new(tasks, st)
        if nxt is None:
            print(DIM("You've passed every task already. "
                      "Revisit a lesson with:  ") + f"{SELF} learn <id>")
            return
        tid = nxt[0]
    meta = tasks[tid]
    short = tid.split("/", 1)[1]
    print(BLD(f"\nLESSON — {meta['domain']}: {meta['title']}") + DIM(f"  [{tid}]"))
    print(DIM(f"objective: {meta.get('objective','')}"))
    print("─" * 60)

    lesson = meta["_dir"] / "learn.md"
    if not lesson.exists():
        print(DIM("No written lesson for this task yet — read the spec, give it a"))
        print(DIM("go, and reveal a worked solution with  ") + f"{INVOKE} solution")
        print("\n" + (meta["_dir"] / "prompt.md").read_text().rstrip())
        print("─" * 60)
        if ask(BLD("Set up its workspace so you can try it? ")
               + DIM("[Enter = yes, q = later] ")) not in ("q", "quit"):
            launch_task(st, tid, meta)
        else:
            print(DIM("When you're ready:  ") + f"{SELF} start {short}")
        return

    finished = run_lesson(parse_lesson(lesson.read_text()))
    print("─" * 60)
    if not finished:
        print(DIM("Lesson paused. Pick it back up any time:  ") + f"{SELF} learn {short}")
        return
    print(GRN("That's the lesson.")
          + DIM("  Best way to make it stick is to do it yourself."))
    if ask(BLD("Set up its workspace and try it now? ")
           + DIM("[Enter = yes, q = later] ")) not in ("q", "quit"):
        launch_task(st, tid, meta)
    else:
        print(DIM("When you're ready:  ") + f"{SELF} start {short}")

# ---- check -----------------------------------------------------------------
def cmd_check(args):
    tasks = discover()
    st = load_state()
    ident = args[0] if args else st.get("current")
    if not ident:
        die(f"nothing to check — run '{INVOKE} train' first, "
            f"or name a task: {SELF} check <id>")
    tid = resolve(tasks, ident)
    meta = tasks[tid]
    if not task_python_ok(meta):
        print(YEL(f"SKIP: needs Python >= {meta['python']} (you have {sys.version.split()[0]})"))
        return
    print(BLD(f"\nGrading: {meta['title']}"))
    passed, skip_note, output = grade(tid, meta)
    rec = st["tasks"].setdefault(tid, {"passed": False, "attempts": 0})
    if skip_note:
        print(YEL(f"SKIP: {skip_note}"))
        return
    rec["attempts"] += 1
    if passed:
        was_review = rec.get("passed", False)
        print(GRN(BLD("PASS")) + f" — {meta['title']}")
        if was_review:
            reps, xp = rec.get("reps", 1) + 1, 5     # cheaper: you already know it
        else:
            reps, xp = 1, XP_BY_DIFFICULTY.get(meta.get("difficulty", 1), 10)
        rec["passed"] = True
        schedule_review(rec, reps)
        st["xp"] += xp
        bump_streak(st)
        print(GRN(f"+{xp} XP") + DIM(f"  (total {st['xp']}, streak {st['streak']['count']})"))
        print(DIM(f"Next review in {review_interval(reps)}d.  Next task:  ") + f"{INVOKE} train")
    else:
        if rec.get("passed"):        # a lapse — relearn from the start, soon
            rec["reps"] = 0
            rec["due"] = date.today().isoformat()
        print(RED(BLD("FAIL")) + f" — {meta['title']}\n")
        print(trim_pytest(output))
        print(DIM("\nFix it and re-run  ") + f"{INVOKE} check"
              + DIM("   (stuck?  ") + f"{SELF} solution {tid}" + DIM(")"))
    save_state(st)
    if not passed:
        sys.exit(1)

def trim_pytest(out):
    """Show the useful part of pytest output, not the whole wall."""
    lines = out.splitlines()
    keep, capture = [], False
    for ln in lines:
        if ln.startswith("=") and ("FAILURES" in ln or "ERRORS" in ln):
            capture = True
        if capture or ln.startswith(("FAILED", "ERROR", "PASSED")) or " passed" in ln or " failed" in ln or " error" in ln:
            keep.append(ln)
    text = "\n".join(keep) or out
    return text if len(text) < 4000 else text[:4000] + "\n... (truncated)"

def cmd_solution(args):
    tasks = discover()
    st = load_state()
    ident = args[0] if args else st.get("current")
    if not ident:
        die(f"nothing to show — name a task: {SELF} solution <id>")
    tid = resolve(tasks, ident)
    meta = tasks[tid]
    sol_dir = meta["_dir"] / "solution"
    print(BLD(f"Reference solution — {meta['title']}\n"))
    if sol_dir.is_dir():
        for f in sorted(sol_dir.rglob("*.py")):
            print(BLU(f"--- {f.relative_to(sol_dir)} ---"))
            print(f.read_text())
    else:
        print((meta["_dir"] / "solution.py").read_text())

def cmd_reset(args):
    tasks = discover()
    st = load_state()
    ident = args[0] if args else st.get("current")
    if not ident:
        die(f"nothing to reset — name a task: {SELF} reset <id>")
    tid = resolve(tasks, ident)
    populate_workspace(tid, tasks[tid], force=True)
    print(f"workspace for {tid} reset to the starter scaffold")

def cmd_status(_args):
    tasks = discover()
    st = load_state()
    print(BLD(f"\nXP: {st['xp']}   streak: {st['streak']['count']} day(s)"
              + (DIM(f"  (last active {st['streak']['last']})") if st['streak']['last'] else "")))
    domains = {}
    for tid in tasks:
        domains.setdefault(tid.split("/")[0], []).append(tid)
    print()
    for dom in sorted(domains):
        ids = domains[dom]
        done = sum(1 for t in ids if st["tasks"].get(t, {}).get("passed"))
        width = 24
        filled = round(width * done / len(ids)) if ids else 0
        bar = GRN("█" * filled) + DIM("░" * (width - filled))
        print(f"  {dom:<14} {bar} {done}/{len(ids)}")
    print()

COMMANDS = {
    "learn": cmd_learn, "train": cmd_train, "next": cmd_train,
    "list": cmd_list, "start": cmd_start, "check": cmd_check,
    "solution": cmd_solution, "reset": cmd_reset, "status": cmd_status,
}

def main():
    if sys.version_info < MIN_PY:
        die(f"pytrain needs Python >= {'.'.join(map(str, MIN_PY))}")
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    fn = COMMANDS.get(args[0])
    if not fn:
        die(f"unknown command '{args[0]}' (try: {INVOKE} help)")
    fn(args[1:])

if __name__ == "__main__":
    main()
